---
interface Props {
  name?: string;
  tagline?: string;
  description?: string;
  image?: string;
}

const {
  name = "Your Name",
  tagline = "Full Stack Developer",
  description = "Building beautiful, performant web experiences with modern technologies.",
  image = ""
} = Astro.props;
---

<section class="hero" id="hero">
  <!-- Star sparkle container -->
  <div class="sparkle-container" id="sparkle-container"></div>
  
  <div class="hero-content">
    <div class="hero-text">
      <p class="greeting">
        <span class="wave-emoji">👋</span> Hello, I'm
      </p>
      <h1 class="name">
        <span class="typing-text" id="typing-name">{name}</span>
        <span class="typing-cursor">|</span>
      </h1>
      <h2 class="tagline">
        <span class="tagline-words" id="tagline-container">
          {tagline.split(' ').map((word, i) => (
            <span class="tagline-word" style={`animation-delay: ${0.5 + i * 0.1}s`}>{word}</span>
          ))}
        </span>
      </h2>
      <p class="description fade-in-up">{description}</p>
      
      <div class="cta-buttons">
        <a href="/resume.pdf" class="btn btn-primary magnetic-hover download-resume" download="Bala_Sai_Kishore_Kadiyam_Resume.pdf">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span class="btn-text">Download Resume</span>
        </a>
        <a href="#contact" class="btn btn-secondary magnetic-hover">
          <span class="btn-text">Get in Touch</span>
          <span class="btn-icon">💬</span>
        </a>
      </div>
      
      <!-- Scroll indicator -->
      <div class="scroll-indicator">
        <div class="mouse">
          <div class="wheel"></div>
        </div>
        <span class="scroll-text">Scroll to explore</span>
      </div>
    </div>
    
    <div class="hero-visual" id="hero-visual">
      <div class="profile-image-container" id="character-container">
        <!-- Animated Character - Modern Avatar -->
        <div class="animated-character" id="animated-character">
          <!-- Floating particles around character -->
          <div class="character-particles">
            <span class="particle p1">✦</span>
            <span class="particle p2">✧</span>
            <span class="particle p3">◈</span>
            <span class="particle p4">✦</span>
            <span class="particle p5">◇</span>
          </div>
          
          <!-- Glow ring behind character -->
          <div class="character-glow"></div>
          <div class="character-glow glow-2"></div>
          
          <!-- Character Container -->
          <div class="character-body">
            <!-- Head with face -->
            <div class="character-head">
              <!-- Animated gradient background -->
              <div class="head-bg"></div>
              
              <!-- Hair with animation -->
              <div class="character-hair">
                <div class="hair-strand s1"></div>
                <div class="hair-strand s2"></div>
                <div class="hair-strand s3"></div>
              </div>
              
              <!-- Face -->
              <div class="character-face">
                <!-- Eyes with blink animation -->
                <div class="character-eyes">
                  <div class="eye left-eye">
                    <div class="eye-white">
                      <div class="iris">
                        <div class="pupil"></div>
                        <div class="eye-shine"></div>
                      </div>
                    </div>
                    <div class="eyelid"></div>
                  </div>
                  <div class="eye right-eye">
                    <div class="eye-white">
                      <div class="iris">
                        <div class="pupil"></div>
                        <div class="eye-shine"></div>
                      </div>
                    </div>
                    <div class="eyelid"></div>
                  </div>
                </div>
                
                <!-- Eyebrows -->
                <div class="eyebrow left-eyebrow"></div>
                <div class="eyebrow right-eyebrow"></div>
                
                <!-- Nose -->
                <div class="character-nose"></div>
                
                <!-- Mouth with expressions -->
                <div class="character-mouth">
                  <div class="mouth-inner"></div>
                </div>
                
                <!-- Blush cheeks -->
                <div class="blush left-blush"></div>
                <div class="blush right-blush"></div>
              </div>
            </div>
            
            <!-- Body/Torso -->
            <div class="character-torso">
              <!-- Shirt design -->
              <div class="shirt-collar"></div>
              <div class="shirt-logo">💻</div>
              
              <!-- Arms -->
              <div class="arm left-arm">
                <div class="forearm">
                  <div class="hand">
                    <span class="hand-emoji">🤚</span>
                  </div>
                </div>
              </div>
              <div class="arm right-arm">
                <div class="forearm">
                  <div class="hand">
                    <span class="hand-emoji">👋</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Speech Bubble with better design -->
          <div class="speech-bubble" id="speech-bubble">
            <div class="bubble-content">
              <span class="speech-text" id="speech-text">Hi there! 👋</span>
            </div>
            <div class="bubble-tail"></div>
          </div>
          
          <!-- Action indicators -->
          <div class="action-hearts" id="action-hearts">
            <span class="heart h1">💖</span>
            <span class="heart h2">✨</span>
            <span class="heart h3">💕</span>
          </div>
        </div>
        <p class="character-hint">
          <span class="hint-icon">👆</span> 
          <span class="hint-text">Hover & click me!</span>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  // Star sparkle effect on mouse move
  const sparkleContainer = document.getElementById('sparkle-container');
  let lastSparkleTime = 0;
  const sparkleDelay = 50; // Minimum time between sparkles in ms
  
  function createStar(x: number, y: number) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    
    const star = document.createElement('div');
    star.className = 'sparkle-star';
    
    // Random size for variety
    const size = Math.random() * 15 + 10;
    star.style.width = `${size}px`;
    star.style.height = `${size}px`;
    
    // Position at cursor
    star.style.left = `${x - size / 2}px`;
    star.style.top = `${y - size / 2}px`;
    
    // Random rotation
    star.style.setProperty('--rotation', `${Math.random() * 360}deg`);
    
    // Random color (gold, white, or accent)
    const colors = ['#ffd700', '#ffffff', '#a78bfa', '#60a5fa'];
    star.style.setProperty('--star-color', colors[Math.floor(Math.random() * colors.length)]);
    
    sparkleContainer?.appendChild(star);
    
    // Remove after animation
    setTimeout(() => {
      star.remove();
    }, 1000);
  }
  
  document.addEventListener('mousemove', (e) => {
    const now = Date.now();
    if (now - lastSparkleTime >= sparkleDelay) {
      createStar(e.clientX, e.clientY);
      lastSparkleTime = now;
    }
  });
  
  // Animated Character Interactions
  const character = document.getElementById('animated-character');
  const speechBubble = document.getElementById('speech-bubble');
  const speechText = document.getElementById('speech-text');
  const actionHearts = document.getElementById('action-hearts');
  
  const greetings = [
    'Hi there! 👋', 
    'Hello! ✨', 
    'Hey! Nice to see you! 😊', 
    'Welcome! 🎉', 
    'Glad you\'re here! 💫',
    'Let\'s build something! 🚀'
  ];
  
  const clickReactions = [
    { text: 'Hehe! That tickles! 😆', mood: 'happy' },
    { text: 'Wheee! 🎢', mood: 'excited' },
    { text: 'You found me! 🙈', mood: 'shy' },
    { text: 'Boop! 👆', mood: 'playful' },
    { text: '*giggles* ✨', mood: 'happy' },
    { text: 'Again! Again! 🎪', mood: 'excited' }
  ];
  
  let isAnimating = false;
  let clickCount = 0;
  
  // Hover - Greeting animation
  character?.addEventListener('mouseenter', () => {
    if (isAnimating) return;
    
    character.classList.add('hover-active');
    speechBubble?.classList.add('visible');
    
    const randomGreeting = greetings[Math.floor(Math.random() * greetings.length)];
    if (speechText) speechText.textContent = randomGreeting;
    
    // Wave animation
    character.classList.add('waving');
  });
  
  character?.addEventListener('mouseleave', () => {
    if (isAnimating) return;
    
    character.classList.remove('hover-active', 'waving');
    speechBubble?.classList.remove('visible');
  });
  
  // Click - Fun reaction with bounce and hearts
  character?.addEventListener('click', (e) => {
    if (isAnimating) return;
    isAnimating = true;
    clickCount++;
    
    // Get random reaction
    const reaction = clickReactions[Math.floor(Math.random() * clickReactions.length)];
    
    // Show speech bubble with reaction
    speechBubble?.classList.add('visible');
    if (speechText) speechText.textContent = reaction.text;
    
    // Add bounce animation
    character.classList.add('bounce-animation');
    character.classList.add(`mood-${reaction.mood}`);
    
    // Show floating hearts/sparkles
    actionHearts?.classList.add('visible');
    
    // Special animation every 5 clicks
    if (clickCount % 5 === 0) {
      character.classList.add('spin-animation');
      if (speechText) speechText.textContent = 'Woohoo! 🌟🎉🌟';
    }
    
    // Reset after animation
    setTimeout(() => {
      character.classList.remove('bounce-animation', 'spin-animation');
      character.classList.remove('mood-happy', 'mood-excited', 'mood-shy', 'mood-playful');
      actionHearts?.classList.remove('visible');
      
      if (!character.matches(':hover')) {
        speechBubble?.classList.remove('visible');
      }
      
      isAnimating = false;
    }, 1200);
  });
  
  // Eye tracking - pupils follow cursor with smooth interpolation
  const leftIris = document.querySelector('.left-eye .iris') as HTMLElement;
  const rightIris = document.querySelector('.right-eye .iris') as HTMLElement;
  const leftPupil = document.querySelector('.left-eye .pupil') as HTMLElement;
  const rightPupil = document.querySelector('.right-eye .pupil') as HTMLElement;
  
  // Smooth tracking variables
  let targetX = 0;
  let targetY = 0;
  let currentX = 0;
  let currentY = 0;
  const smoothing = 0.15; // Lower = smoother but slower
  
  // Track mouse position
  document.addEventListener('mousemove', (e) => {
    if (!character) return;
    
    const characterRect = character.getBoundingClientRect();
    const eyeCenterX = characterRect.left + characterRect.width / 2;
    const eyeCenterY = characterRect.top + characterRect.height * 0.35;
    
    // Calculate direction and distance
    const deltaX = e.clientX - eyeCenterX;
    const deltaY = e.clientY - eyeCenterY;
    const distance = Math.hypot(deltaX, deltaY);
    
    // Normalize and calculate movement (max 6px movement)
    const maxMove = 6;
    const normalizedDistance = Math.min(distance / 150, 1);
    const angle = Math.atan2(deltaY, deltaX);
    
    targetX = Math.cos(angle) * maxMove * normalizedDistance;
    targetY = Math.sin(angle) * maxMove * normalizedDistance;
    
    // Dilate pupils based on distance (closer = bigger pupils - curiosity)
    const pupilScale = distance < 200 ? 1.3 : distance < 400 ? 1.1 : 1;
    if (leftPupil) leftPupil.style.transform = `translate(-50%, -50%) scale(${pupilScale})`;
    if (rightPupil) rightPupil.style.transform = `translate(-50%, -50%) scale(${pupilScale})`;
  });
  
  // Smooth animation loop for eye movement
  function animateEyes() {
    // Lerp towards target
    currentX += (targetX - currentX) * smoothing;
    currentY += (targetY - currentY) * smoothing;
    
    // Apply slightly different positions to each eye for natural look
    const leftOffsetX = currentX * 0.9;
    const rightOffsetX = currentX * 1.1;
    
    if (leftIris) {
      leftIris.style.transform = `translate(calc(-50% + ${leftOffsetX}px), calc(-50% + ${currentY}px))`;
    }
    if (rightIris) {
      rightIris.style.transform = `translate(calc(-50% + ${rightOffsetX}px), calc(-50% + ${currentY}px))`;
    }
    
    requestAnimationFrame(animateEyes);
  }
  
  // Start the animation loop
  animateEyes();
  
  // Add occasional "look around" when idle
  let lastMoveTime = Date.now();
  let idleLookTimeout: ReturnType<typeof setTimeout>;
  
  function scheduleIdleLook() {
    idleLookTimeout = setTimeout(() => {
      if (Date.now() - lastMoveTime > 3000) {
        // Random idle look
        const randomX = (Math.random() - 0.5) * 8;
        const randomY = (Math.random() - 0.5) * 4;
        targetX = randomX;
        targetY = randomY;
        
        // Return to center after a moment
        setTimeout(() => {
          if (Date.now() - lastMoveTime > 3000) {
            targetX = 0;
            targetY = 0;
          }
        }, 1500);
      }
      scheduleIdleLook();
    }, 4000 + Math.random() * 3000);
  }
  
  scheduleIdleLook();
  
  // Update last move time on mouse movement
  document.addEventListener('mousemove', () => {
    lastMoveTime = Date.now();
  });
</script>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: var(--space-xl) var(--space-lg);
    padding-top: calc(var(--space-xl) + 60px);
    position: relative;
    overflow: hidden;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    max-width: 1200px;
    width: 100%;
    align-items: center;
  }

  .hero-text {
    z-index: 1;
  }

  .greeting {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .name {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: var(--space-sm);
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tagline {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  .description {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 500px;
    margin-bottom: var(--space-lg);
  }

  .cta-buttons {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .btn {
    padding: var(--space-sm) var(--space-lg);
    border-radius: var(--radius-md);
    font-weight: 600;
    transition: all var(--transition-fast);
  }

  .btn-primary {
    background-color: var(--color-primary);
    color: white;
  }

  .btn-primary:hover {
    background-color: var(--color-primary-hover);
    color: white;
    transform: translateY(-2px);
  }

  /* Flashy Download Resume Button */
  .download-resume {
    display: inline-flex !important;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #6366f1, #8b5cf6, #a855f7) !important;
    background-size: 200% 200%;
    color: white !important;
    padding: 12px 24px;
    border-radius: 10px;
    font-weight: 600;
    position: relative;
    overflow: hidden;
    animation: gradientFlow 3s ease infinite;
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
  }

  .download-resume::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.4),
      transparent
    );
    transition: left 0.5s ease;
  }

  .download-resume:hover::before {
    left: 100%;
  }

  .download-resume::after {
    content: '';
    position: absolute;
    inset: -3px;
    background: linear-gradient(135deg, #6366f1, #8b5cf6, #a855f7, #6366f1);
    background-size: 400% 400%;
    border-radius: 12px;
    z-index: -1;
    opacity: 0;
    transition: opacity 0.3s ease;
    animation: borderGlow 2s ease infinite;
  }

  .download-resume:hover::after {
    opacity: 1;
  }

  .download-resume:hover {
    transform: translateY(-4px) scale(1.05);
    box-shadow: 
      0 8px 30px rgba(99, 102, 241, 0.5),
      0 0 40px rgba(139, 92, 246, 0.3),
      inset 0 0 20px rgba(255, 255, 255, 0.1);
  }

  .download-resume:active {
    transform: translateY(-2px) scale(0.98);
    animation: clickPulse 0.4s ease;
  }

  .download-resume svg {
    transition: transform 0.3s ease;
  }

  .download-resume:hover svg {
    animation: bounceDown 0.6s ease infinite;
  }

  .download-resume:active svg {
    animation: downloadPop 0.3s ease;
  }

  @keyframes gradientFlow {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  @keyframes borderGlow {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  @keyframes bounceDown {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  @keyframes clickPulse {
    0% { box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.7); }
    50% { box-shadow: 0 0 0 20px rgba(99, 102, 241, 0); }
    100% { box-shadow: 0 0 0 0 rgba(99, 102, 241, 0); }
  }

  @keyframes downloadPop {
    0% { transform: scale(1); }
    50% { transform: scale(1.3) translateY(5px); }
    100% { transform: scale(1) translateY(0); }
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--color-text);
    border: 2px solid var(--color-border);
  }

  .btn-secondary:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .hero-visual {
    position: relative;
    height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Profile Image Styles */
  .profile-image-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .character-hint {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-text-muted);
    font-size: 0.875rem;
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-bg-secondary);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .hint-icon {
    animation: pointUp 1s ease-in-out infinite;
  }

  @keyframes pointUp {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }

  /* ============================================
     🎭 MODERN ANIMATED CHARACTER
     ============================================ */
  
  .animated-character {
    position: relative;
    width: 220px;
    height: 300px;
    cursor: pointer;
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .animated-character:hover,
  .animated-character.hover-active {
    transform: scale(1.08);
  }

  /* Floating Particles */
  .character-particles {
    position: absolute;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .particle {
    position: absolute;
    font-size: 1rem;
    opacity: 0.6;
    animation: floatParticle 4s ease-in-out infinite;
    color: var(--color-primary);
  }

  .p1 { top: 10%; left: 5%; animation-delay: 0s; }
  .p2 { top: 20%; right: 0%; animation-delay: 0.8s; }
  .p3 { top: 50%; left: -5%; animation-delay: 1.6s; }
  .p4 { bottom: 30%; right: -5%; animation-delay: 2.4s; }
  .p5 { bottom: 10%; left: 10%; animation-delay: 3.2s; }

  @keyframes floatParticle {
    0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0.4; }
    50% { transform: translateY(-15px) rotate(180deg); opacity: 1; }
  }

  /* Glow Effect Behind Character */
  .character-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 180px;
    height: 180px;
    background: radial-gradient(circle, var(--color-primary) 0%, transparent 70%);
    opacity: 0.3;
    border-radius: 50%;
    animation: pulseGlow 3s ease-in-out infinite;
    z-index: 0;
  }

  .glow-2 {
    width: 220px;
    height: 220px;
    background: radial-gradient(circle, var(--color-accent) 0%, transparent 70%);
    animation-delay: 1.5s;
    opacity: 0.2;
  }

  @keyframes pulseGlow {
    0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.3; }
    50% { transform: translate(-50%, -50%) scale(1.2); opacity: 0.5; }
  }

  /* Character Body Container */
  .character-body {
    position: relative;
    width: 100%;
    height: 100%;
    z-index: 1;
    animation: gentleFloat 4s ease-in-out infinite;
  }

  @keyframes gentleFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  /* Head */
  .character-head {
    position: absolute;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: 130px;
    height: 130px;
    z-index: 2;
  }

  .head-bg {
    position: absolute;
    width: 100%;
    height: 100%;
    background: linear-gradient(145deg, #ffecd2, #fcb69f);
    border-radius: 50% 50% 45% 45%;
    box-shadow: 
      0 10px 30px rgba(0,0,0,0.1),
      inset 0 -10px 30px rgba(0,0,0,0.05);
  }

  /* Hair with animated strands */
  .character-hair {
    position: absolute;
    top: -15px;
    left: 50%;
    transform: translateX(-50%);
    width: 140px;
    height: 80px;
    background: linear-gradient(135deg, #4a3728 0%, #2d1f16 50%, #4a3728 100%);
    background-size: 200% 200%;
    border-radius: 70px 70px 30px 30px;
    z-index: 3;
    animation: hairShine 5s ease-in-out infinite;
    overflow: hidden;
  }

  @keyframes hairShine {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .hair-strand {
    position: absolute;
    bottom: -5px;
    width: 25px;
    height: 40px;
    background: #3d2d20;
    border-radius: 0 0 50% 50%;
    animation: hairWave 2s ease-in-out infinite;
  }

  .s1 { left: 20%; animation-delay: 0s; }
  .s2 { left: 45%; animation-delay: 0.3s; height: 45px; }
  .s3 { left: 70%; animation-delay: 0.6s; }

  @keyframes hairWave {
    0%, 100% { transform: rotate(-3deg); }
    50% { transform: rotate(3deg); }
  }

  /* Face */
  .character-face {
    position: absolute;
    top: 25px;
    left: 50%;
    transform: translateX(-50%);
    width: 110px;
    height: 95px;
  }

  /* Eyes */
  .character-eyes {
    position: absolute;
    top: 25px;
